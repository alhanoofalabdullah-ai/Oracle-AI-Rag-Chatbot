
---

# `.env.example`

```env
# ==========================================================
# Oracle Connection
# ==========================================================

ORACLE_USER=monitoring_user

ORACLE_PASSWORD=change_me

ORACLE_DSN=localhost:1521/FREEPDB1


# ==========================================================
# Application
# ==========================================================

APP_NAME=Oracle Performance Monitoring & SQL Tuning Platform

LOG_LEVEL=INFO


# ==========================================================
# Performance Thresholds
# ==========================================================

CPU_WARNING_PERCENT=70

CPU_CRITICAL_PERCENT=90

TABLESPACE_WARNING_PERCENT=75

TABLESPACE_CRITICAL_PERCENT=90

ACTIVE_SESSION_WARNING=50

ACTIVE_SESSION_CRITICAL=100

SQL_ELAPSED_WARNING_SECONDS=5

SQL_ELAPSED_CRITICAL_SECONDS=30
